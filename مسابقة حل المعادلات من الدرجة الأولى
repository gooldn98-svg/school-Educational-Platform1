
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لعبة حل معادلات الدرجة الأولى</title>
    <style>
        :root {
            --primary-color: #4CAF50;
            --secondary-color: #2196F3;
            --background-color: #f0f8ff;
            --text-color: #333;
            --correct-color: #4CAF50;
            --incorrect-color: #f44336;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--background-color);
            color: var(--text-color);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
            box-sizing: border-box;
        }

        .game-container {
            background-color: white;
            border-radius: 15px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            padding: 40px;
            max-width: 600px;
            width: 100%;
            text-align: center;
        }

        h1 {
            color: var(--secondary-color);
            margin-bottom: 20px;
        }

        .math-text {
            font-size: 24px;
            font-weight: bold;
            direction: rtl; /* Ensure math reads correctly in Arabic */
            margin: 20px 0;
            padding: 15px;
            background-color: #e3f2fd;
            border-radius: 8px;
            display: inline-block;
        }

        .options-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 20px;
        }

        .option-btn {
            background-color: #fff;
            border: 2px solid var(--secondary-color);
            color: var(--secondary-color);
            padding: 15px;
            font-size: 18px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: inherit;
        }

        .option-btn:hover {
            background-color: var(--secondary-color);
            color: white;
        }
        
        .option-btn:disabled {
            cursor: not-allowed;
            opacity: 0.8;
        }

        .option-btn.correct {
            background-color: var(--correct-color);
            border-color: var(--correct-color);
            color: white;
        }

        .option-btn.incorrect {
            background-color: var(--incorrect-color);
            border-color: var(--incorrect-color);
            color: white;
        }

        .feedback {
            margin-top: 20px;
            font-size: 20px;
            font-weight: bold;
            min-height: 30px;
            opacity: 0;
            transition: opacity 0.3s;
        }
        
        .feedback.show {
            opacity: 1;
        }

        .feedback.correct-text { color: var(--correct-color); }
        .feedback.incorrect-text { color: var(--incorrect-color); }

        .progress-container {
            margin-top: 30px;
        }

        .progress-text {
            margin-bottom: 10px;
            font-weight: bold;
        }

        .next-btn {
            background-color: var(--primary-color);
            color: white;
            border: none;
            padding: 12px 25px;
            font-size: 18px;
            border-radius: 8px;
            cursor: pointer;
            margin-top: 20px;
            display: none;
            transition: background-color 0.3s;
        }

        .next-btn:hover {
            background-color: #45a049;
        }

        .result-screen {
            display: none;
        }

        .celebration {
            font-size: 60px;
            margin: 20px 0;
        }
        
        .restart-btn {
            background-color: var(--secondary-color);
            color: white;
            border: none;
            padding: 12px 25px;
            font-size: 18px;
            border-radius: 8px;
            cursor: pointer;
            margin-top: 20px;
        }
    </style>
</head>
<body>

<div class="game-container" id="gameScreen">
    <h1>لعبة تحدي المعادلات</h1>
    <div class="progress-text" id="progressText">السؤال 1 من 10</div>
    
    <div>أوجد قيمة <span style="font-weight:bold;">س</span> في المعادلة التالية:</div>
    <div class="math-text" id="equationDisplay">س + ٥ = ١٢</div>
    
    <div class="options-container" id="optionsContainer">
        <!-- Options will be generated here by JavaScript -->
    </div>
    
    <div class="feedback" id="feedbackElement"></div>
    <button class="next-btn" id="nextBtn" onclick="nextQuestion()">السؤال التالي</button>
</div>

<div class="game-container result-screen" id="resultScreen">
    <h1>انتهى التحدي!</h1>
    <div class="celebration" id="celebrationEmoji">🎉</div>
    <h2>نتيجتك: <span id="scoreDisplay">0</span> من 10</h2>
    <p id="resultMessage" style="font-size: 18px; line-height: 1.6;"></p>
    <button class="restart-btn" onclick="startGame()">العب مرة أخرى</button>
</div>

<script>
    // Note: Using standard Arabic numerals (١, ٢, ٣...) for display, 
    // but calculating with standard JS numbers.
    const toArabicNumerals = (num) => {
        const arabicNumbers = ['٠', '١', '٢', '٣', '٤', '٥', '٦', '٧', '٨', '٩'];
        let str = num.toString();
        // Handle negative sign
        let isNegative = str.startsWith('-');
        if(isNegative) str = str.substring(1);
        
        let arabicStr = str.split('').map(char => {
            return char >= '0' && char <= '9' ? arabicNumbers[parseInt(char)] : char;
        }).join('');
        
        // In Arabic RTL, negative sign usually comes on the right or left depending on context, 
        // we'll put it on the right visually in RTL context by just prepending it.
        return isNegative ? '-' + arabicStr : arabicStr;
    };

    const questions = [
        {
            equation: "س + ٥ = ١٢",
            correctAnswer: 7,
            options: [5, 7, 17, 6],
            encouragement: "ممتاز! بداية قوية."
        },
        {
            equation: "س - ٤ = ٩",
            correctAnswer: 13,
            options: [5, 13, 12, 14],
            encouragement: "أحسنت! استمر هكذا."
        },
        {
            equation: "٣س = ١٥",
            correctAnswer: 5,
            options: [12, 18, 5, 3],
            encouragement: "رائع! أنت تفهم الضرب جيداً."
        },
        {
            equation: "٢س + ١ = ٧",
            correctAnswer: 3,
            options: [3, 4, 6, 8],
            encouragement: "عمل رائع! خطوتان في معادلة واحدة."
        },
        {
            equation: "٤س - ٢ = ١٠",
            correctAnswer: 3,
            options: [3, 2, 4, 8],
            encouragement: "بطل! إجابة دقيقة."
        },
        {
            equation: "س ÷ ٢ = ٦",
            correctAnswer: 12,
            options: [3, 8, 12, 4],
            encouragement: "عبقري! القسمة لا تشكل عائقاً لك."
        },
        {
            equation: "٥س = ٢٠",
            correctAnswer: 4,
            options: [4, 15, 25, 5],
            encouragement: "مذهل! سرعتك في الحساب رائعة."
        },
        {
            equation: "س + ٨ = ٣",
            correctAnswer: -5,
            options: [5, 11, -5, -11],
            encouragement: "ذكي جداً! الأعداد السالبة سهلة بالنسبة لك."
        },
        {
            equation: "٣س - ٥ = ٤",
            correctAnswer: 3,
            options: [3, 1, 9, -1],
            encouragement: "مبدع! اقتربت من النهاية."
        },
        {
            equation: "٢س + ٤ = ١٢",
            correctAnswer: 4,
            options: [4, 8, 16, 6],
            encouragement: "ختامها مسك! أنت خبير في المعادلات."
        }
    ];

    let currentQuestionIndex = 0;
    let score = 0;

    const gameScreen = document.getElementById('gameScreen');
    const resultScreen = document.getElementById('resultScreen');
    const equationDisplay = document.getElementById('equationDisplay');
    const optionsContainer = document.getElementById('optionsContainer');
    const progressText = document.getElementById('progressText');
    const feedbackElement = document.getElementById('feedbackElement');
    const nextBtn = document.getElementById('nextBtn');

    // Utility to shuffle options
    function shuffleArray(array) {
        for (let i = array.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [array[i], array[j]] = [array[j], array[i]];
        }
        return array;
    }

    function startGame() {
        currentQuestionIndex = 0;
        score = 0;
        gameScreen.style.display = 'block';
        resultScreen.style.display = 'none';
        loadQuestion();
    }

    function loadQuestion() {
        const currentQ = questions[currentQuestionIndex];
        
        // Reset UI
        feedbackElement.className = 'feedback';
        feedbackElement.textContent = '';
        nextBtn.style.display = 'none';
        optionsContainer.innerHTML = '';
        
        // Set texts
        progressText.textContent = `السؤال ${currentQuestionIndex + 1} من ${questions.length}`;
        equationDisplay.textContent = currentQ.equation;

        // Shuffle and create options
        const shuffledOptions = shuffleArray([...currentQ.options]);
        
        shuffledOptions.forEach(opt => {
            const btn = document.createElement('button');
            btn.className = 'option-btn';
            btn.textContent = `س = ${toArabicNumerals(opt)}`;
            btn.onclick = () => checkAnswer(opt, btn);
            optionsContainer.appendChild(btn);
        });
    }

    function checkAnswer(selectedAnswer, btnElement) {
        const currentQ = questions[currentQuestionIndex];
        const buttons = document.querySelectorAll('.option-btn');
        
        // Disable all buttons
        buttons.forEach(btn => btn.disabled = true);

        feedbackElement.classList.add('show');

        if (selectedAnswer === currentQ.correctAnswer) {
            btnElement.classList.add('correct');
            feedbackElement.textContent = currentQ.encouragement;
            feedbackElement.className = 'feedback show correct-text';
            score++;
        } else {
            btnElement.classList.add('incorrect');
            feedbackElement.textContent = "حاول مرة أخرى في السؤال القادم! الإجابة الصحيحة هي: س = " + toArabicNumerals(currentQ.correctAnswer);
            feedbackElement.className = 'feedback show incorrect-text';
            
            // Highlight correct answer
            buttons.forEach(btn => {
                if (btn.textContent.includes(toArabicNumerals(currentQ.correctAnswer))) {
                    btn.classList.add('correct');
                }
            });
        }

        nextBtn.style.display = 'inline-block';
        if (currentQuestionIndex === questions.length - 1) {
            nextBtn.textContent = 'إنهاء التحدي';
        } else {
            nextBtn.textContent = 'السؤال التالي';
        }
    }

    function nextQuestion() {
        currentQuestionIndex++;
        if (currentQuestionIndex < questions.length) {
            loadQuestion();
        } else {
            showResults();
        }
    }

    function showResults() {
        gameScreen.style.display = 'none';
        resultScreen.style.display = 'block';
        
        document.getElementById('scoreDisplay').textContent = score;
        const resultMsg = document.getElementById('resultMessage');
        const emoji = document.getElementById('celebrationEmoji');

        if (score === 10) {
            emoji.textContent = "🏆";
            resultMsg.textContent = "عبقري رياضيات! لقد أجبت على جميع الأسئلة بشكل صحيح. أنت تتقن حل معادلات الدرجة الأولى بامتياز.";
        } else if (score >= 7) {
            emoji.textContent = "🌟";
            resultMsg.textContent = "أداء رائع جداً! لديك فهم ممتاز للمعادلات، بقليل من التدريب ستصل للعلامة الكاملة.";
        } else if (score >= 5) {
            emoji.textContent = "👍";
            resultMsg.textContent = "أداء جيد! لقد اجتزت نصف التحدي بنجاح. راجع الخطوات وحاول مرة أخرى لتحسين نتيجتك.";
        } else {
            emoji.textContent = "💪";
            resultMsg.textContent = "لا تستسلم! حل المعادلات يحتاج إلى الممارسة. استمر في التدريب وستلاحظ تحسناً كبيراً.";
        }
    }

    // Start game initially
    startGame();
</script>

</body>
</html>
